; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-6169304823027068~2885705018"

[application]

config/name="Arrow Traffic"
run/main_scene="res://main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05882353, 0.05882353, 0.05882353, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

Economy="*res://services/economy.gd"
Ads="*res://services/ads.gd"
IAP="*res://services/iap.gd"
Review="*res://services/review.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/android_manifest_fix/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.059, 0.059, 0.059, 1)
